{
  "name": "oibsip-pizza-app",
  "version": "1.0.0",
  "description": "Full-stack pizza delivery app: React + Node/Express + MongoDB",
  "scripts": {
    "install-all": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "razorpay": "^2.9.4"
  },
  "engines": {
    "node": ">=18"
  }
}
