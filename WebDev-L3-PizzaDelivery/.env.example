# ============================================================
#  Pizza app configuration. Copy this file to ".env" (same folder
#  as package.json) and fill in the values. This is the ONLY file
#  you need to edit. Never commit your real .env to GitHub.
# ============================================================

# ---- Server ----
PORT=5000
# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
# The address people open in the browser (used inside email links).
APP_URL=http://localhost:5000

# ---- MongoDB (REQUIRED) ----
# Option A, local MongoDB installed on your PC:
#   mongodb://127.0.0.1:27017/pizza_app
# Option B, free MongoDB Atlas cluster (cloud.mongodb.com):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pizza_app
MONGO_URI=mongodb://127.0.0.1:27017/pizza_app

# ---- Admin ----
# The admin account is NOT created through the sign-up page. It is created (or updated)
# from these two values every time the server starts. Admins log in at /admin-login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
# Low-stock alert emails are sent to this address.
ADMIN_ALERT_EMAIL=
# A scheduled job checks stock on this schedule (cron format, default every 30 minutes).
# An ingredient is "low" when its stock is at or below its own threshold (set in the admin page).
LOW_STOCK_CRON=*/30 * * * *

# ---- Razorpay (test mode) ----
# Get keys: razorpay.com -> sign up -> Dashboard -> switch to "Test Mode"
# -> Account & Settings -> API Keys -> Generate Test Key.
# Leave blank and the app still runs, but online payment shows "not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (SMTP) ----
# Used for email verification, forgot password and low-stock alerts.
# Gmail example: host smtp.gmail.com, port 587, user = your Gmail address,
# pass = a Google "App Password" (Google Account -> Security -> 2-Step Verification -> App passwords).
# Leave blank and the app still runs, but no email is sent (the screen tells you so).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pizza App <no-reply@example.com>"

# ---- Demo switches ----
# true  = when SMTP is not configured, show the verification / reset link ON SCREEN
#         (clearly labelled "email NOT sent"). Set to false for a real deployment.
DEMO_SHOW_LINKS=true
# true  = when Razorpay is not configured, allow placing an order that is clearly marked
#         "UNPAID (demo)". It is never shown as paid. Set to false to block ordering without payment.
ALLOW_UNPAID_DEMO_ORDERS=true
